{
  "examples": [
    {
      "id": "basics/gate",
      "title": "The gate",
      "category": "Basics",
      "blurb": "One command that answers \"is this fine?\" — lint and test scheduled by footman, one test wrong on purpose.",
      "files": {
        "tasks.py": [
          "from typing import Literal",
          "from footman import fail, run, task",
          "from toolroom import pytest, ruff",
          "",
          "@task",
          "def lint(fix: bool = False):",
          "    \"Lint the source tree.\"",
          "    # a typed wrapper: keywords become flags, False is omitted",
          "    ruff.check(\"src\", fix=fix)",
          "",
          "@task(serial=True)   # in-process pytest touches the process globals",
          "def test():",
          "    \"Run the tests — real pytest, in your browser.\"",
          "    pytest(\"-q\", \"test_demo.py\")",
          "",
          "@task",
          "def deploy(target: Literal[\"dev\", \"staging\", \"prod\"],",
          "           regions: list[Literal[\"eu\", \"us\", \"ap\"]] | None = None):",
          "    \"Ship to an environment.\"",
          "    run(f\"./rollout.sh {target} --regions={','.join(regions or ['eu'])}\")",
          "",
          "@task",
          "def audit():",
          "    \"Refuses on purpose — try it with -k.\"",
          "    fail(\"the gate is red — deliberately\", code=3)",
          "",
          "@task(pre=[lint, test])",
          "def check():",
          "    \"Lint and test; footman schedules the rest.\""
        ],
        "test_demo.py": [
          "def fizzbuzz(n):",
          "    if n % 15 == 0:",
          "        return \"fizzbuzz\"",
          "    if n % 3 == 0:",
          "        return \"fizz\"",
          "    if n % 5 == 0:",
          "        return \"buzz\"",
          "    return str(n)",
          "",
          "def test_three():",
          "    assert fizzbuzz(3) == \"fizz\"",
          "",
          "def test_fifteen():",
          "    assert fizzbuzz(15) == \"fizzbuzz\"",
          "",
          "def test_wrong():",
          "    assert fizzbuzz(4) == \"fizz\"   # deliberately failing — fix it and rerun"
        ]
      },
      "commands": [
        {
          "line": "check",
          "note": "the gate — red until you fix fizzbuzz",
          "exit": 1,
          "shows": ["1 failed, 2 passed"]
        },
        {
          "line": "--dry-run lint --fix",
          "note": "the plan, not the work — see the command a flag builds",
          "exit": 0,
          "shows": ["$ ruff check src --fix"]
        },
        {
          "line": "-k check audit",
          "note": "keep going: collect every failure in one run",
          "exit": 1,
          "shows": ["FAIL"]
        },
        {
          "line": "--list",
          "note": "every task, from the docstrings",
          "exit": 0,
          "shows": ["Tasks:"]
        }
      ]
    },
    {
      "id": "validation/deploy",
      "title": "Belt-and-braces deploy",
      "category": "Validation",
      "blurb": "Markers stack — path requirement, custom check, bounds, env fallback — and every refusal is a taught error.",
      "files": {
        "tasks.py": [
          "from pathlib import Path",
          "from typing import Annotated",
          "from footman import run, task",
          "from footman.params import between, check, env, isfile",
          "",
          "def semver(value: str) -> None:",
          "    import re",
          "    if not re.fullmatch(r\"\\d+\\.\\d+\\.\\d+\", value):",
          "        raise ValueError(f\"expected MAJOR.MINOR.PATCH, got {value!r}\")",
          "",
          "@task",
          "def deploy(",
          "    config: Annotated[Path, isfile],",
          "    version: Annotated[str, check(semver)],",
          "    workers: Annotated[int, between(1, 32)] = 4,",
          "    target: Annotated[str, env(\"DEPLOY_ENV\")] = \"staging\",",
          "):",
          "    \"Roll out.\"",
          "    print(f\"deploying {version} from {config} with {workers} workers to {target}\")",
          "    run(f\"./rollout.sh {version} --config={config} -j{workers} --target={target}\")"
        ]
      },
      "commands": [
        {
          "line": "deploy config.toml 1.2.3",
          "note": "everything validates; target falls back past $DEPLOY_ENV",
          "exit": 0,
          "shows": ["with 4 workers to staging"]
        },
        {
          "line": "deploy config.toml 1.2.3 --workers=64",
          "note": "bounds refuse, eagerly, before anything runs",
          "exit": 64,
          "shows": ["between 1 and 32"]
        },
        {
          "line": "deploy config.toml nope",
          "note": "your own validator teaches in your own words",
          "exit": 64,
          "shows": ["MAJOR.MINOR.PATCH"]
        }
      ]
    },
    {
      "id": "variadic/bench",
      "title": "Extra args, passed through",
      "category": "Variadic",
      "blurb": "A defaulted option in front, *args behind: bare words and everything after -- land in the variadic tail.",
      "files": {
        "tasks.py": [
          "from footman import task",
          "",
          "@task",
          "def bench(runs: int = 3, *pytest_args):",
          "    \"Time the suite; anything after -- goes to pytest.\"",
          "    print(f\"runs={runs} pytest_args={list(pytest_args)}\")"
        ]
      },
      "commands": [
        {
          "line": "bench -- -q -x",
          "note": "passthrough lands in *args, never in --runs",
          "exit": 0,
          "shows": ["runs=3 pytest_args=['-q', '-x']"]
        },
        {
          "line": "bench --runs=5 fast slow",
          "note": "the option binds by name; bare words join the tail",
          "exit": 0,
          "shows": ["runs=5 pytest_args=['fast', 'slow']"]
        }
      ]
    }
  ]
}
